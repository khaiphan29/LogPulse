SERVER_HOST=localhost
SERVER_PORT=8080

KAFKA_BOOTSTRAP_SERVERS=localhost:9092 # the initial contact point so that the client (consumer/producer) can connect to the cluster.
KAFKA_BROKER1_HOST=localhost
KAFKA_BROKER1_PORT=9092

# # Kafka topics configuration
# KAFKA_LOG_TOPIC=logs
# KAFKA_LOG_TOPIC_PARTITIONS=3
# KAFKA_LOG_TOPIC_COMPRESSION_TYPE=lz4
# KAFKA_LOG_TOPIC_RETENTION_MS=604800000  # 7 days
# KAFKA_LOG_DLQ_TOPIC=logs-dlq
# KAFKA_LOG_DLQ_TOPIC_PARTITIONS=3
# KAFKA_LOG_DLQ_TOPIC_COMPRESSION_TYPE=lz4
# KAFKA_LOG_DLQ_TOPIC_RETENTION_MS=-1  # infinite
# KAFKA_LOG_DLQ_PERMANENT_TOPIC=logs-dlq-permanent
# KAFKA_LOG_DLQ_PERMANENT_TOPIC_PARTITIONS=3
# KAFKA_LOG_DLQ_PERMANENT_TOPIC_COMPRESSION_TYPE=lz4
# KAFKA_LOG_DLQ_PERMANENT_TOPIC_RETENTION_MS=-1  # infinite
# # Kafka consumer offset topic configuration
# KAFKA_CONSUMER_OFFSET_TOPIC=__consumer_offsets
# KAFKA_CONSUMER_OFFSET_TOPIC_PARTITIONS=5
# KAFKA_CONSUMER_OFFSET_TOPIC_RETENTION_MS=-1  # infinite
# KAFKA_CONSUMER_OFFSET_TOPIC_CLEANUP_POLICY=compact

# Kafka consumer configuration
KAFKA_CONSUMER_LOG_GROUP_ID=log-consumer-group
KAFKA_CONSUMER_LOG_NUM_OF_CONSUMERS=3
KAFKA_CONSUMER_LOG_TOPICS=logs
KAFKA_CONSUMER_LOG_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_LOG_AUTO_COMMIT=false
KAFKA_CONSUMER_LOG_AUTO_OFFSET_STORE=true

# ES configuration
ES_HOST=localhost
ES_PORT=9200

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX_KEY=logpulse:

# Cache configuration
CACHE_LOG_COUNT_KEY=error_log_count
CACHE_LOG_COUNT_TTL=24h

# Error analytics configuration
ANALYZER_LOG_ERROR_THRESHOLD=2
ANALYZER_LOG_ERROR_TIME_WINDOW=24h
